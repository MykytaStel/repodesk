import { useCallback, useEffect, useMemo, useState } from "react";
import { invoke } from "@tauri-apps/api/core";
import "./App.css";

type TabKey = "workflow" | "setup" | "git" | "ai" | "actions" | "artifacts" | "history" | "debug" | "raw";
type ToastKind = "success" | "error" | "info" | "warning";
type Tone = "good" | "warn" | "bad" | "neutral";

type Toast = { id: number; kind: ToastKind; title: string; message: string };
type DebugEvent = {
  id: number;
  command: string;
  status: "success" | "error";
  durationMs: number;
  timestamp: string;
  args?: Record<string, unknown>;
  preview?: string;
  error?: string;
};

type CommandResult = {
  ok?: boolean;
  command?: string;
  stdout?: string;
  stderr?: string;
  exit_code?: number | null;
  status?: string;
  message?: string;
  error?: string;
};

type DesktopAction = {
  id: string;
  title?: string;
  label?: string;
  description?: string;
  category?: string;
  risk?: string;
  command_preview?: string;
};

type ActionRunResult = {
  id?: string;
  action_id?: string;
  title?: string;
  risk?: string;
  category?: string;
  started_at_ms?: number;
  finished_at_ms?: number;
  result?: CommandResult;
};

type WorkflowStep = {
  id?: string;
  title?: string;
  description?: string;
  status?: string;
  action_id?: string | null;
  artifact_kind?: string | null;
};

type ArtifactStatus = {
  kind: string;
  title?: string;
  path?: string;
  exists: boolean;
  size_bytes?: number;
};

type ArtifactContent = ArtifactStatus & { content?: string };

type ProductWorkflowState = {
  project_ok?: boolean;
  task_ok?: boolean;
  recommended_action_id?: string | null;
  next_action_id?: string | null;
  next_action?: { action_id?: string | null; title?: string; description?: string } | null;
  steps?: WorkflowStep[];
  artifacts?: ArtifactStatus[];
  checks_summary_preview?: string;
  project_info?: CommandResult;
  task_status?: CommandResult;
  [key: string]: unknown;
};

type GitFileChange = {
  path: string;
  status_code: string;
  status_label: string;
  staged: boolean;
  unstaged: boolean;
  untracked: boolean;
  deleted: boolean;
  renamed: boolean;
};

type GitWorkspaceSnapshot = {
  ok: boolean;
  project_name?: string | null;
  project_path?: string | null;
  is_git_repo: boolean;
  branch?: string | null;
  last_commit?: string | null;
  is_dirty: boolean;
  staged_count: number;
  unstaged_count: number;
  untracked_count: number;
  changed_files: GitFileChange[];
  diff_stat: string;
  cached_diff_stat: string;
  raw_status: string;
  warnings: string[];
  generated_at: string;
};

type AiDiscoveryTool = {
  name: string;
  kind?: string;
  status?: string;
  detected?: boolean;
  details?: string;
  command?: string;
  path?: string | null;
};

type AiDiscoveryEndpoint = {
  name: string;
  url?: string;
  host?: string;
  port?: number;
  reachable?: boolean;
  status?: string;
};

type AiDiscoveryReport = {
  generated_at?: string;
  tools?: AiDiscoveryTool[];
  endpoints?: AiDiscoveryEndpoint[];
  warnings?: string[];
  recommendations?: string[];
  [key: string]: unknown;
};

type ProjectAddInput = {
  name: string;
  path: string;
  project_type: string;
  main_language?: string | null;
};

const tabs: { key: TabKey; label: string; hint: string }[] = [
  { key: "workflow", label: "Workflow", hint: "Daily loop" },
  { key: "setup", label: "Setup", hint: "Project & task" },
  { key: "git", label: "Git", hint: "Workspace state" },
  { key: "ai", label: "AI Discovery", hint: "Local tools" },
  { key: "actions", label: "Actions", hint: "Safe commands" },
  { key: "artifacts", label: "Artifacts", hint: "Prompts & context" },
  { key: "history", label: "History", hint: "What happened" },
  { key: "debug", label: "Debug", hint: "Tauri calls" },
  { key: "raw", label: "Raw", hint: "JSON" },
];

const artifactKinds = [
  { kind: "smart_context", label: "Smart context", description: "Small AI-ready task context." },
  { kind: "context", label: "Context", description: "Fuller project/task context." },
  { kind: "prompt_codex", label: "Codex prompt", description: "Patch-oriented prompt." },
  { kind: "prompt_chatgpt", label: "ChatGPT prompt", description: "Planning/review prompt." },
  { kind: "prompt_review", label: "Review prompt", description: "Human review prompt." },
  { kind: "checks_summary", label: "Checks summary", description: "Short failure summary." },
  { kind: "token_estimate", label: "Token estimate", description: "Budget estimate." },
];

function stringifyPreview(value: unknown): string {
  try {
    const text = typeof value === "string" ? value : JSON.stringify(value, null, 2);
    return text.length > 1200 ? `${text.slice(0, 1200)}\n…` : text;
  } catch {
    return String(value);
  }
}

function normalizeLabel(value?: string | null): string {
  if (!value) return "unknown";
  return value.replace(/_/g, " ");
}

function formatBytes(value?: number): string {
  if (!value) return "0 B";
  if (value < 1024) return `${value} B`;
  if (value < 1024 * 1024) return `${(value / 1024).toFixed(1)} KB`;
  return `${(value / 1024 / 1024).toFixed(1)} MB`;
}

function formatDuration(item?: ActionRunResult): string {
  if (!item?.started_at_ms || !item.finished_at_ms) return "unknown duration";
  const ms = Math.max(0, item.finished_at_ms - item.started_at_ms);
  if (ms < 1000) return `${ms}ms`;
  return `${(ms / 1000).toFixed(1)}s`;
}

function actionTitle(action?: DesktopAction): string {
  return action?.title || action?.label || action?.id || "Action";
}

function commandOutput(result?: CommandResult): string {
  if (!result) return "No output yet.";
  const parts = [];
  if (result.command) parts.push(`$ ${result.command}`);
  if (result.message) parts.push(result.message);
  if (result.stdout) parts.push(result.stdout.trim());
  if (result.stderr) parts.push(`stderr:\n${result.stderr.trim()}`);
  if (result.error) parts.push(`error:\n${result.error}`);
  if (parts.length === 0) parts.push(JSON.stringify(result, null, 2));
  return parts.join("\n\n");
}

function byGitGroup(changes: GitFileChange[], group: "staged" | "unstaged" | "untracked") {
  return changes.filter((item) => item[group]);
}

function riskTone(risk?: string): Tone {
  if (risk === "safe" || risk === "read_only") return "good";
  if (risk === "expensive" || risk === "dangerous") return "bad";
  if (risk === "guarded" || risk === "medium") return "warn";
  return "neutral";
}

function statusTone(status?: string): Tone {
  const normalized = (status || "").toLowerCase();
  if (["done", "ready", "success", "ok", "clean", "found", "reachable"].includes(normalized)) return "good";
  if (["blocked", "failed", "error", "missing"].includes(normalized)) return "bad";
  if (["current", "warning", "warn", "dirty", "pending"].includes(normalized)) return "warn";
  return "neutral";
}

function StatusPill({ tone, label }: { tone: Tone; label: string }) {
  return <span className={`pill ${tone}`}>{label}</span>;
}

function SectionTitle({ eyebrow, title, body }: { eyebrow?: string; title: string; body?: string }) {
  return (
    <div className="sectionTitle">
      {eyebrow && <span>{eyebrow}</span>}
      <h3>{title}</h3>
      {body && <p>{body}</p>}
    </div>
  );
}

function EmptyState({ title, body, action }: { title: string; body: string; action?: React.ReactNode }) {
  return (
    <div className="emptyState">
      <div className="emptyIcon">◇</div>
      <strong>{title}</strong>
      <span>{body}</span>
      {action}
    </div>
  );
}

function OutputBlock({ title, result }: { title: string; result?: CommandResult }) {
  return (
    <section className="panel compact">
      <div className="panelHeader">
        <SectionTitle title={title} body="Latest command output from the local core." />
        <StatusPill tone={result?.ok ? "good" : "neutral"} label={result?.ok ? "ok" : "output"} />
      </div>
      <pre className="output small">{commandOutput(result)}</pre>
    </section>
  );
}

function SkeletonCard() {
  return (
    <div className="panel skeletonPanel">
      <div className="skeletonLine short" />
      <div className="skeletonLine" />
      <div className="skeletonLine" />
      <div className="skeletonLine tiny" />
    </div>
  );
}

export default function App() {
  const [activeTab, setActiveTab] = useState<TabKey>(() => (localStorage.getItem("repodesk.activeTab") as TabKey) || "workflow");
  const [booting, setBooting] = useState(true);
  const [busyLabel, setBusyLabel] = useState<string | null>(null);
  const [toasts, setToasts] = useState<Toast[]>([]);
  const [debugEvents, setDebugEvents] = useState<DebugEvent[]>([]);
  const [snapshot, setSnapshot] = useState<unknown>(null);
  const [workflow, setWorkflow] = useState<ProductWorkflowState | null>(null);
  const [actions, setActions] = useState<DesktopAction[]>([]);
  const [history, setHistory] = useState<ActionRunResult[]>([]);
  const [git, setGit] = useState<GitWorkspaceSnapshot | null>(null);
  const [aiReport, setAiReport] = useState<AiDiscoveryReport | null>(null);
  const [artifact, setArtifact] = useState<ArtifactContent | null>(null);
  const [lastResult, setLastResult] = useState<ActionRunResult | null>(null);

  const [projectName, setProjectName] = useState("repodesk");
  const [projectPath, setProjectPath] = useState("");
  const [projectType, setProjectType] = useState("rust-cli");
  const [mainLanguage, setMainLanguage] = useState("rust");
  const [switchProjectName, setSwitchProjectName] = useState("repodesk");
  const [taskTitle, setTaskTitle] = useState("Improve RepoDesk workflow");

  useEffect(() => {
    localStorage.setItem("repodesk.activeTab", activeTab);
  }, [activeTab]);

  const pushToast = useCallback((kind: ToastKind, title: string, message: string) => {
    const id = Date.now() + Math.floor(Math.random() * 1000);
    setToasts((items) => [...items, { id, kind, title, message }].slice(-5));
    window.setTimeout(() => {
      setToasts((items) => items.filter((item) => item.id !== id));
    }, 4600);
  }, []);

  const safeInvoke = useCallback(
    async <T,>(command: string, args?: Record<string, unknown>, options?: { toast?: boolean; label?: string }): Promise<T | null> => {
      const started = performance.now();
      try {
        const result = await invoke<T>(command, args);
        const durationMs = Math.round(performance.now() - started);
        setDebugEvents((events) => [
          {
            id: Date.now() + Math.random(),
            command,
            args,
            status: "success" as const,
            durationMs,
            timestamp: new Date().toLocaleTimeString(),
            preview: stringifyPreview(result),
          },
          ...events,
        ].slice(0, 100));
        if (options?.toast) pushToast("success", options.label || command, `Completed in ${durationMs}ms`);
        return result;
      } catch (error) {
        const durationMs = Math.round(performance.now() - started);
        const message = error instanceof Error ? error.message : String(error);
        setDebugEvents((events) => [
          {
            id: Date.now() + Math.random(),
            command,
            args,
            status: "error" as const,
            durationMs,
            timestamp: new Date().toLocaleTimeString(),
            error: message,
          },
          ...events,
        ].slice(0, 100));
        if (options?.toast !== false) pushToast("error", options?.label || command, message);
        return null;
      }
    },
    [pushToast],
  );

  const refreshCore = useCallback(async () => {
    const [nextSnapshot, nextWorkflow, nextActions, nextHistory, nextGit] = await Promise.all([
      safeInvoke<unknown>("desktop_snapshot", undefined, { toast: false }),
      safeInvoke<ProductWorkflowState>("product_workflow_state", undefined, { toast: false }),
      safeInvoke<DesktopAction[]>("desktop_actions", undefined, { toast: false }),
      safeInvoke<ActionRunResult[]>("action_history", undefined, { toast: false }),
      safeInvoke<GitWorkspaceSnapshot>("git_workspace_snapshot", undefined, { toast: false }),
    ]);

    if (nextSnapshot) setSnapshot(nextSnapshot);
    if (nextWorkflow) setWorkflow(nextWorkflow);
    if (nextActions) setActions(nextActions);
    if (nextHistory) setHistory(nextHistory);
    if (nextGit) setGit(nextGit);
  }, [safeInvoke]);

  const scanAi = useCallback(async () => {
    setBusyLabel("Scanning local AI tools");
    const report = await safeInvoke<AiDiscoveryReport>("ai_discovery_scan", undefined, { toast: true, label: "AI discovery" });
    if (report) setAiReport(report);
    setBusyLabel(null);
  }, [safeInvoke]);

  const boot = useCallback(async () => {
    setBooting(true);
    setBusyLabel("Loading RepoDesk cockpit");
    await refreshCore();
    setBusyLabel("Scanning Git workspace");
    await safeInvoke<GitWorkspaceSnapshot>("git_workspace_snapshot", undefined, { toast: false }).then((value) => value && setGit(value));
    setBusyLabel(null);
    setBooting(false);
  }, [refreshCore, safeInvoke]);

  useEffect(() => {
    void boot();
  }, [boot]);

  const actionById = useMemo(() => new Map(actions.map((action) => [action.id, action])), [actions]);
  const artifactsByKind = useMemo(() => new Map((workflow?.artifacts || []).map((item) => [item.kind, item])), [workflow]);
  const latestDebug = debugEvents[0];

  const nextActionId = useMemo(() => {
    const fromWorkflow = workflow?.recommended_action_id || workflow?.next_action_id || workflow?.next_action?.action_id;
    if (fromWorkflow) return fromWorkflow;
    const firstStepAction = workflow?.steps?.find((step) => step.action_id && step.status !== "done")?.action_id;
    return firstStepAction || "workflow-next";
  }, [workflow]);

  const gitDirtyWarning = git?.is_dirty ? `Workspace has ${git.changed_files.length} changed file(s). Review Git before patch/AI actions.` : null;

  const readyChecklist = useMemo(() => {
    const smartContext = artifactsByKind.get("smart_context")?.exists;
    const context = artifactsByKind.get("context")?.exists;
    const codexPrompt = artifactsByKind.get("prompt_codex")?.exists;
    const checks = artifactsByKind.get("checks_summary")?.exists;
    return [
      { label: "Project connected", done: Boolean(workflow?.project_ok) },
      { label: "Task selected", done: Boolean(workflow?.task_ok) },
      { label: "Context built", done: Boolean(context) },
      { label: "Smart context built", done: Boolean(smartContext) },
      { label: "Prompt generated", done: Boolean(codexPrompt) },
      { label: "Checks summary exists", done: Boolean(checks) },
      { label: "Git reviewed", done: !git?.is_dirty },
    ];
  }, [artifactsByKind, git?.is_dirty, workflow?.project_ok, workflow?.task_ok]);

  const runAction = useCallback(
    async (actionId: string) => {
      const action = actionById.get(actionId);
      if (!action) {
        pushToast("error", "Unknown action", actionId);
        return;
      }
      if (git?.is_dirty && ["guarded", "expensive"].includes(action.risk || "")) {
        pushToast("warning", "Dirty workspace", "Review Git tab before continuing with guarded/AI actions.");
      }
      setBusyLabel(actionTitle(action));
      const result = await safeInvoke<ActionRunResult>("run_desktop_action", { actionId }, { toast: true, label: actionTitle(action) });
      if (result) setLastResult(result);
      await refreshCore();
      setBusyLabel(null);
    },
    [actionById, git?.is_dirty, pushToast, refreshCore, safeInvoke],
  );

  const doNextSafeStep = useCallback(async () => {
    await runAction(nextActionId);
  }, [nextActionId, runAction]);

  const connectProject = useCallback(async () => {
    const input: ProjectAddInput = {
      name: projectName.trim(),
      path: projectPath.trim(),
      project_type: projectType.trim(),
      main_language: mainLanguage.trim() || null,
    };
    setBusyLabel("Connecting project");
    const added = await safeInvoke<CommandResult>("project_add", { input }, { toast: true, label: "Add project" });
    if (added?.ok) await safeInvoke<CommandResult>("project_use", { name: input.name }, { toast: true, label: "Use project" });
    await refreshCore();
    setBusyLabel(null);
  }, [mainLanguage, projectName, projectPath, projectType, refreshCore, safeInvoke]);

  const activateProject = useCallback(async () => {
    setBusyLabel("Switching project");
    await safeInvoke<CommandResult>("project_use", { name: switchProjectName.trim() }, { toast: true, label: "Use project" });
    await refreshCore();
    setBusyLabel(null);
  }, [refreshCore, safeInvoke, switchProjectName]);

  const createTask = useCallback(async () => {
    setBusyLabel("Creating task");
    await safeInvoke<CommandResult>("task_new", { title: taskTitle.trim() }, { toast: true, label: "Create task" });
    await refreshCore();
    setBusyLabel(null);
  }, [refreshCore, safeInvoke, taskTitle]);

  const loadArtifact = useCallback(
    async (kind: string) => {
      setBusyLabel("Loading artifact");
      const content = await safeInvoke<ArtifactContent>("read_artifact", { kind }, { toast: true, label: `Load ${normalizeLabel(kind)}` });
      if (content) setArtifact(content);
      setBusyLabel(null);
    },
    [safeInvoke],
  );

  const copyArtifact = useCallback(async () => {
    if (!artifact?.content) return;
    await navigator.clipboard.writeText(artifact.content);
    pushToast("success", "Copied", artifact.title || artifact.kind);
  }, [artifact, pushToast]);

  if (booting) {
    return (
      <main className="bootScreen">
        <div className="bootCard">
          <div className="orb" />
          <span className="eyebrow">Local-first AI cockpit</span>
          <h1>RepoDesk is preparing your workspace</h1>
          <p>{busyLabel || "Starting control brain, Git scanner, and workflow state."}</p>
          <div className="loaderBar"><span /></div>
          <div className="bootSkeletons"><SkeletonCard /><SkeletonCard /><SkeletonCard /></div>
        </div>
      </main>
    );
  }

  return (
    <main className="appShell">
      {busyLabel && (
        <div className="busyOverlay">
          <div className="busyCard">
            <div className="spinner" />
            <strong>{busyLabel}</strong>
            <span>Running through a bounded Tauri command. Check Debug if it fails.</span>
          </div>
        </div>
      )}

      <div className="toastStack">
        {toasts.map((toast) => (
          <div key={toast.id} className={`toast ${toast.kind}`}>
            <strong>{toast.title}</strong>
            <span>{toast.message}</span>
          </div>
        ))}
      </div>

      <aside className="sidebar">
        <div className="brand">
          <div className="logoMark">R</div>
          <div>
            <h1>RepoDesk</h1>
            <span>Control brain for local AI work</span>
          </div>
        </div>

        <nav>
          {tabs.map((tab) => (
            <button key={tab.key} className={activeTab === tab.key ? "active" : ""} onClick={() => setActiveTab(tab.key)}>
              <strong>{tab.label}</strong>
              <span>{tab.hint}</span>
            </button>
          ))}
        </nav>

        <div className="sideCard">
          <span>Workspace</span>
          <strong>{git?.project_name || "No project"}</strong>
          <small>{git?.branch || "unknown branch"}</small>
          {git?.is_dirty ? <StatusPill tone="warn" label="dirty" /> : <StatusPill tone="good" label="clean" />}
        </div>

        <div className="sideCard subtle">
          <span>Last command</span>
          <strong>{latestDebug?.command || "none yet"}</strong>
          {latestDebug ? <small>{latestDebug.status} · {latestDebug.durationMs}ms</small> : <small>Open Debug after running actions.</small>}
        </div>
      </aside>

      <section className="content">
        <header className="topbar">
          <div>
            <span className="eyebrow">{tabs.find((tab) => tab.key === activeTab)?.hint}</span>
            <h2>{tabs.find((tab) => tab.key === activeTab)?.label}</h2>
            <p>{gitDirtyWarning || "RepoDesk is ready. Use the primary action or inspect Git/Debug first."}</p>
          </div>
          <div className="topActions">
            <button onClick={() => void refreshCore()}>Refresh</button>
            <button className="primary" onClick={() => void doNextSafeStep()}>Do next safe step</button>
          </div>
        </header>

        <div className="statusStrip">
          <StatusCard label="Project" value={workflow?.project_ok ? "Connected" : "Missing"} tone={workflow?.project_ok ? "good" : "warn"} />
          <StatusCard label="Task" value={workflow?.task_ok ? "Selected" : "Missing"} tone={workflow?.task_ok ? "good" : "warn"} />
          <StatusCard label="Git" value={git?.is_dirty ? `${git.changed_files.length} changes` : "Clean"} tone={git?.is_dirty ? "warn" : "good"} />
          <StatusCard label="Next" value={normalizeLabel(nextActionId)} tone="neutral" />
        </div>

        {activeTab === "workflow" && (
          <div className="grid two">
            <section className="panel heroPanel wideHero">
              <div className="panelHeader">
                <SectionTitle eyebrow="Recommended loop" title="Do the next safe thing" body="RepoDesk should guide the workflow, not make you guess what happened." />
                <StatusPill tone={workflow?.project_ok && workflow?.task_ok ? "good" : "warn"} label={workflow?.project_ok && workflow?.task_ok ? "ready" : "setup"} />
              </div>
              {gitDirtyWarning && <div className="warningBox">{gitDirtyWarning}</div>}
              <div className="primaryActionBox">
                <div>
                  <span>Next action</span>
                  <strong>{normalizeLabel(nextActionId)}</strong>
                  <p>{workflow?.next_action?.description || "Runs only through the desktop allowlist."}</p>
                </div>
                <button className="primary large" onClick={() => void doNextSafeStep()}>Run next safe step</button>
              </div>
              {lastResult && (
                <div className="lastResult">
                  <div className="panelHeader">
                    <h3>Last action result</h3>
                    <StatusPill tone={lastResult.result?.ok ? "good" : "bad"} label={`${lastResult.result?.ok ? "success" : "failed"} · ${formatDuration(lastResult)}`} />
                  </div>
                  <pre className="output small">{commandOutput(lastResult.result)}</pre>
                </div>
              )}
            </section>

            <section className="panel">
              <SectionTitle title="Ready checklist" body="This is the fastest way to see what is missing." />
              <div className="checklist">
                {readyChecklist.map((item) => (
                  <div key={item.label} className={item.done ? "done" : "todo"}>
                    <span>{item.done ? "✓" : "!"}</span>
                    <strong>{item.label}</strong>
                  </div>
                ))}
              </div>
            </section>

            <section className="panel">
              <SectionTitle title="Workflow timeline" body="Visible progress through project → task → context → checks." />
              <div className="timeline">
                {(workflow?.steps || []).length > 0 ? workflow?.steps?.map((step, index) => (
                  <div key={`${step.id || step.title}-${index}`} className={`timelineStep ${step.status || "unknown"}`}>
                    <span>{index + 1}</span>
                    <div>
                      <strong>{step.title || step.id}</strong>
                      <p>{step.description || normalizeLabel(step.status)}</p>
                    </div>
                    <StatusPill tone={statusTone(step.status)} label={normalizeLabel(step.status)} />
                  </div>
                )) : <EmptyState title="No workflow state yet" body="Create a task or refresh the cockpit." />}
              </div>
            </section>

            <OutputBlock title="Project info" result={workflow?.project_info} />
            <OutputBlock title="Task status" result={workflow?.task_status} />
          </div>
        )}

        {activeTab === "setup" && (
          <div className="grid two">
            <section className="panel">
              <SectionTitle eyebrow="Step 1" title="Add and activate project" body="Connect RepoDesk to a local repository path." />
              <label>Project name<input value={projectName} onChange={(event) => setProjectName(event.target.value)} /></label>
              <label>Project path<input value={projectPath} onChange={(event) => setProjectPath(event.target.value)} placeholder="/Users/mykyta/Documents/projects/repopilot" /></label>
              <div className="formRow">
                <label>Project type<input value={projectType} onChange={(event) => setProjectType(event.target.value)} /></label>
                <label>Main language<input value={mainLanguage} onChange={(event) => setMainLanguage(event.target.value)} /></label>
              </div>
              <button className="primary" onClick={() => void connectProject()}>Add and activate project</button>
            </section>
            <section className="panel">
              <SectionTitle eyebrow="Step 2" title="Use existing project and create task" body="Task is the unit of AI work and context generation." />
              <label>Project name<input value={switchProjectName} onChange={(event) => setSwitchProjectName(event.target.value)} /></label>
              <button onClick={() => void activateProject()}>Use project</button>
              <div className="divider" />
              <label>Task title<input value={taskTitle} onChange={(event) => setTaskTitle(event.target.value)} /></label>
              <button className="primary" onClick={() => void createTask()}>Create task</button>
            </section>
          </div>
        )}

        {activeTab === "git" && (
          <div className="grid two">
            <section className="panel heroPanel wideHero">
              <div className="panelHeader">
                <SectionTitle title="Git workspace" body="RepoDesk must know what changed before you ask an agent to patch files." />
                {git?.is_dirty ? <StatusPill tone="warn" label="dirty" /> : <StatusPill tone="good" label="clean" />}
              </div>
              <div className="metrics">
                <div><span>Branch</span><strong>{git?.branch || "unknown"}</strong></div>
                <div><span>Staged</span><strong>{git?.staged_count ?? 0}</strong></div>
                <div><span>Unstaged</span><strong>{git?.unstaged_count ?? 0}</strong></div>
                <div><span>Untracked</span><strong>{git?.untracked_count ?? 0}</strong></div>
              </div>
              <p className="muted">{git?.project_path || "No active project path."}</p>
              <p className="muted">Last commit: {git?.last_commit || "unknown"}</p>
              <button className="primary" onClick={() => void safeInvoke<GitWorkspaceSnapshot>("git_workspace_snapshot", undefined, { toast: true, label: "Git refresh" }).then((value) => value && setGit(value))}>Refresh Git status</button>
              {git?.warnings?.map((warning) => <div key={warning} className="warningBox">{warning}</div>)}
            </section>

            <section className="panel">
              <SectionTitle title="Diff stat" body="Read-only summary of staged and unstaged changes." />
              <pre className="output small">{[git?.cached_diff_stat && `Staged:\n${git.cached_diff_stat}`, git?.diff_stat && `Unstaged:\n${git.diff_stat}`].filter(Boolean).join("\n") || "No diff stat."}</pre>
            </section>

            <GitFileGroup title="Staged files" files={byGitGroup(git?.changed_files || [], "staged")} />
            <GitFileGroup title="Unstaged files" files={byGitGroup(git?.changed_files || [], "unstaged")} />
            <GitFileGroup title="Untracked files" files={byGitGroup(git?.changed_files || [], "untracked")} />
            <section className="panel"><SectionTitle title="Raw porcelain status" body="Useful when Debug is not enough." /><pre className="output small">{git?.raw_status || "Clean or unavailable."}</pre></section>
          </div>
        )}

        {activeTab === "ai" && (
          <div className="grid two">
            <section className="panel heroPanel wideHero">
              <div className="panelHeader">
                <SectionTitle title="AI discovery" body="Passive scan of local tools, apps, and endpoints. No agents are launched." />
                <StatusPill tone="neutral" label="passive" />
              </div>
              <button className="primary large" onClick={() => void scanAi()}>Scan local AI tools</button>
              {aiReport?.warnings?.map((warning) => <div className="warningBox" key={warning}>{warning}</div>)}
            </section>
            <section className="panel"><SectionTitle title="Local endpoints" body="Ollama and LM Studio should show up here if reachable." /><div className="cards">{(aiReport?.endpoints || []).map((endpoint, index) => <div className="miniCard" key={`${endpoint.name}-${index}`}><strong>{endpoint.name}</strong><span>{endpoint.url || `${endpoint.host}:${endpoint.port}`}</span><StatusPill tone={endpoint.reachable ? "good" : "neutral"} label={endpoint.reachable ? "reachable" : "missing"} /></div>)}</div>{!aiReport?.endpoints?.length && <EmptyState title="No endpoints yet" body="Run AI discovery scan." />}</section>
            <section className="panel wide"><SectionTitle title="Detected tools" body="Found/missing status for local AI and editor tools." /><div className="cards">{(aiReport?.tools || []).map((tool, index) => <div className="miniCard" key={`${tool.name}-${index}`}><strong>{tool.name}</strong><span>{tool.path || tool.command || tool.details || "not found"}</span><StatusPill tone={tool.detected || tool.status === "found" ? "good" : "neutral"} label={tool.detected || tool.status === "found" ? "found" : "missing"} /></div>)}</div>{!aiReport && <EmptyState title="No scan yet" body="Click Scan local AI tools." />}</section>
          </div>
        )}

        {activeTab === "actions" && (
          <div className="grid two">
            {gitDirtyWarning && <div className="warningBox wide">{gitDirtyWarning}</div>}
            {actions.map((action) => <section className="panel actionCard" key={action.id}><div className="panelHeader"><SectionTitle title={actionTitle(action)} body={action.description} /><StatusPill tone={riskTone(action.risk)} label={action.risk || "unknown"} /></div><code>{action.command_preview || action.id}</code><button onClick={() => void runAction(action.id)}>Run action</button></section>)}
            {!actions.length && <EmptyState title="No actions loaded" body="Refresh the cockpit or check Debug." />}
          </div>
        )}

        {activeTab === "artifacts" && (
          <div className="grid two">
            <section className="panel">
              <div className="panelHeader"><SectionTitle title="Artifacts" body="Open generated context, prompts, checks, and token estimates." /><button onClick={() => void copyArtifact()} disabled={!artifact?.content}>Copy</button></div>
              <div className="artifactButtons">{artifactKinds.map((item) => <button key={item.kind} onClick={() => void loadArtifact(item.kind)}><strong>{item.label}</strong><span>{item.description}</span></button>)}</div>
              <div className="artifactGrid">{(workflow?.artifacts || []).map((item) => <div className="miniCard" key={item.kind}><strong>{item.title || normalizeLabel(item.kind)}</strong><span>{formatBytes(item.size_bytes)}</span><StatusPill tone={item.exists ? "good" : "neutral"} label={item.exists ? "exists" : "missing"} /></div>)}</div>
            </section>
            <section className="panel"><div className="panelHeader"><SectionTitle title={artifact?.title || "Artifact preview"} body={artifact?.path || "Select an artifact to inspect."} /><StatusPill tone={artifact?.exists ? "good" : "neutral"} label={artifact?.exists ? "loaded" : "empty"} /></div><pre className="output large">{artifact?.content || "Select an artifact."}</pre></section>
          </div>
        )}

        {activeTab === "history" && (
          <div className="stack">{history.length ? history.map((item, index) => <section className="panel" key={`${item.id}-${index}`}><div className="panelHeader"><SectionTitle title={item.title || item.action_id || item.id || "Action"} body={`${item.category || "action"} · ${formatDuration(item)}`} /><StatusPill tone={item.result?.ok ? "good" : "bad"} label={item.result?.ok ? "success" : "failed"} /></div><pre className="output small">{commandOutput(item.result)}</pre></section>) : <EmptyState title="No action history" body="Run an action from Workflow or Actions." />}</div>
        )}

        {activeTab === "debug" && (
          <div className="stack">{debugEvents.length ? debugEvents.map((event) => <section className="panel" key={event.id}><div className="panelHeader"><SectionTitle title={event.command} body={event.timestamp} /><StatusPill tone={event.status === "success" ? "good" : "bad"} label={`${event.status} · ${event.durationMs}ms`} /></div>{event.args && <pre className="output tiny">args: {JSON.stringify(event.args, null, 2)}</pre>}<pre className="output small">{event.error || event.preview || "No preview."}</pre></section>) : <EmptyState title="No debug events" body="Run actions or refresh the cockpit." />}</div>
        )}

        {activeTab === "raw" && <pre className="output large">{JSON.stringify({ snapshot, workflow, git, aiReport, history }, null, 2)}</pre>}
      </section>
    </main>
  );
}

function StatusCard({ label, value, tone }: { label: string; value: string; tone: Tone }) {
  return (
    <div className={`statusCard ${tone}`}>
      <span>{label}</span>
      <strong>{value}</strong>
    </div>
  );
}

function GitFileGroup({ title, files }: { title: string; files: GitFileChange[] }) {
  return (
    <section className="panel">
      <div className="panelHeader"><SectionTitle title={title} body="Read-only Git status grouping." /><StatusPill tone={files.length ? "warn" : "good"} label={`${files.length}`} /></div>
      {files.length ? <div className="fileList">{files.map((file) => <div key={`${file.status_code}-${file.path}`} className="fileRow"><code>{file.status_code}</code><span>{file.path}</span><em>{file.status_label}</em></div>)}</div> : <EmptyState title="Nothing here" body="This group is clean." />}
    </section>
  );
}
