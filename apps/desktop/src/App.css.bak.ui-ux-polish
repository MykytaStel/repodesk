:root {
  color: #e5eefc;
  background: #070a12;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* { box-sizing: border-box; }
body { margin: 0; min-width: 960px; min-height: 100vh; background: radial-gradient(circle at top left, #1b2b4b 0, #080b13 42%, #05070d 100%); }
button, input { font: inherit; }
button { border: 1px solid #2d3b56; color: #d9e7ff; background: #111827; border-radius: 12px; padding: 0.7rem 0.95rem; cursor: pointer; transition: transform .15s ease, border-color .15s ease, background .15s ease; }
button:hover { transform: translateY(-1px); border-color: #5d7fb7; background: #172338; }
button:disabled { opacity: .45; cursor: not-allowed; }
button.primary { background: linear-gradient(135deg, #4f8cff, #7c3aed); border-color: transparent; color: white; box-shadow: 0 14px 34px rgba(79, 140, 255, .22); }
button.large { width: 100%; margin-top: 1rem; padding: 1rem; font-weight: 800; }
input { width: 100%; margin-top: .35rem; padding: .75rem .85rem; border-radius: 12px; border: 1px solid #26364f; background: #0b1220; color: #eef5ff; }
label { display: block; color: #9fb2cf; margin: .75rem 0; }
code { display: block; color: #a7f3d0; background: #07111d; border: 1px solid #17334f; padding: .55rem .7rem; border-radius: 10px; overflow: auto; }

.bootScreen { min-height: 100vh; display: grid; place-content: center; text-align: center; gap: 1rem; }
.orb { width: 88px; height: 88px; margin: auto; border-radius: 999px; background: conic-gradient(from 90deg, #4f8cff, #7c3aed, #22c55e, #4f8cff); animation: spin 1.3s linear infinite; filter: blur(.2px); }
.loaderBar { height: 8px; width: 320px; background: #111827; border-radius: 999px; overflow: hidden; }
.loaderBar span { display: block; height: 100%; width: 45%; background: #4f8cff; border-radius: inherit; animation: load 1.2s ease-in-out infinite alternate; }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes load { from { transform: translateX(-80%); } to { transform: translateX(190%); } }

.appShell { display: grid; grid-template-columns: 292px 1fr; min-height: 100vh; }
.sidebar { padding: 1.2rem; border-right: 1px solid rgba(148, 163, 184, .15); background: rgba(3, 7, 18, .72); backdrop-filter: blur(18px); position: sticky; top: 0; height: 100vh; }
.brand { display: flex; gap: .8rem; align-items: center; margin-bottom: 1.4rem; }
.logoMark { width: 42px; height: 42px; border-radius: 14px; display: grid; place-content: center; font-weight: 900; background: linear-gradient(135deg, #4f8cff, #7c3aed); }
.brand h1 { font-size: 1.2rem; margin: 0; }
.brand span, .muted { color: #8da2c0; }
nav { display: grid; gap: .45rem; }
nav button { text-align: left; background: transparent; border-color: transparent; }
nav button.active { background: #101a2e; border-color: #2b456f; }
.sideCard { margin-top: 1.4rem; padding: 1rem; border-radius: 18px; background: #0c1424; border: 1px solid #1f2f49; display: grid; gap: .5rem; }
.sideCard span { color: #8da2c0; }

.content { padding: 1.25rem; overflow: auto; }
.topbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1rem; padding: 1rem; border: 1px solid rgba(148, 163, 184, .16); border-radius: 22px; background: rgba(15, 23, 42, .72); }
.topbar h2 { margin: 0 0 .25rem; font-size: 1.55rem; }
.topbar p { margin: 0; color: #9fb2cf; }
.topActions { display: flex; gap: .6rem; }

.grid { display: grid; gap: 1rem; }
.grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.wide { grid-column: 1 / -1; }
.stack { display: grid; gap: 1rem; }
.panel { border: 1px solid rgba(148, 163, 184, .16); border-radius: 22px; padding: 1rem; background: rgba(15, 23, 42, .72); box-shadow: 0 20px 60px rgba(0, 0, 0, .22); }
.panel.compact { min-height: 260px; }
.heroPanel { background: linear-gradient(145deg, rgba(23, 37, 84, .82), rgba(15, 23, 42, .8)); }
.panelHeader { display: flex; justify-content: space-between; align-items: center; gap: .8rem; margin-bottom: .8rem; }
.panel h3 { margin: 0; }
.panel p { color: #b7c6dc; }

.pill { display: inline-flex; align-items: center; border-radius: 999px; padding: .25rem .55rem; font-size: .75rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; border: 1px solid transparent; }
.pill.good { color: #bbf7d0; background: rgba(34, 197, 94, .12); border-color: rgba(34, 197, 94, .28); }
.pill.warn { color: #fde68a; background: rgba(245, 158, 11, .12); border-color: rgba(245, 158, 11, .3); }
.pill.bad { color: #fecaca; background: rgba(239, 68, 68, .13); border-color: rgba(239, 68, 68, .32); }
.pill.neutral { color: #bfdbfe; background: rgba(59, 130, 246, .12); border-color: rgba(59, 130, 246, .28); }
.warningBox { border: 1px solid rgba(245, 158, 11, .32); background: rgba(245, 158, 11, .1); color: #fde68a; padding: .8rem; border-radius: 14px; margin: .75rem 0; }
.emptyState { display: grid; gap: .35rem; color: #8da2c0; border: 1px dashed #2a3b57; border-radius: 16px; padding: 1rem; }

.metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .65rem; margin: .9rem 0; }
.metrics div, .miniCard { padding: .8rem; border-radius: 16px; background: #0b1220; border: 1px solid #1f2f49; display: grid; gap: .35rem; }
.metrics span, .miniCard span { color: #8da2c0; font-size: .85rem; }
.metrics strong { font-size: 1.15rem; overflow: hidden; text-overflow: ellipsis; }
.cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: .75rem; }

.timeline { display: grid; gap: .6rem; }
.timelineStep { display: grid; grid-template-columns: 34px 1fr auto; gap: .75rem; align-items: start; padding: .8rem; border-radius: 16px; background: #0b1220; border: 1px solid #1f2f49; }
.timelineStep span { width: 28px; height: 28px; border-radius: 999px; display: grid; place-content: center; background: #172338; font-weight: 900; }
.timelineStep strong { display: block; }
.timelineStep p { margin: .2rem 0 0; font-size: .9rem; }
.timelineStep em { color: #8da2c0; font-style: normal; font-size: .85rem; }

.fileList { display: grid; gap: .45rem; }
.fileRow { display: grid; grid-template-columns: 54px 1fr auto; gap: .65rem; align-items: center; padding: .55rem; border: 1px solid #1f2f49; border-radius: 12px; background: #0b1220; }
.fileRow code { padding: .25rem .4rem; text-align: center; }
.fileRow span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fileRow em { color: #8da2c0; font-style: normal; font-size: .82rem; }

.output { white-space: pre-wrap; word-break: break-word; background: #050a13; border: 1px solid #172338; border-radius: 14px; padding: .85rem; color: #cfe1ff; max-height: 420px; overflow: auto; }
.output.small { max-height: 260px; font-size: .82rem; }
.output.large { min-height: 68vh; }
.artifactButtons { display: flex; flex-wrap: wrap; gap: .55rem; margin-bottom: .8rem; }
.artifactGrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: .7rem; }
.actionCard { display: grid; gap: .7rem; }

.toastStack { position: fixed; top: 1rem; right: 1rem; z-index: 30; display: grid; gap: .65rem; width: min(420px, calc(100vw - 2rem)); }
.toast { padding: .9rem 1rem; border-radius: 16px; border: 1px solid #2a3b57; background: #0b1220; box-shadow: 0 24px 60px rgba(0,0,0,.35); display: grid; gap: .25rem; animation: toastIn .18s ease-out; }
.toast.success { border-color: rgba(34,197,94,.38); }
.toast.error { border-color: rgba(239,68,68,.4); }
.toast.warning { border-color: rgba(245,158,11,.42); }
.toast span { color: #9fb2cf; }
@keyframes toastIn { from { transform: translateY(-8px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

.busyOverlay { position: fixed; inset: 0; background: rgba(3, 7, 18, .45); backdrop-filter: blur(3px); display: grid; place-content: center; z-index: 20; }
.busyCard { min-width: 320px; border: 1px solid #2a3b57; background: #0b1220; border-radius: 22px; padding: 1.2rem; display: grid; justify-items: center; gap: .7rem; box-shadow: 0 24px 80px rgba(0,0,0,.45); }
.spinner { width: 32px; height: 32px; border-radius: 999px; border: 3px solid #243552; border-top-color: #4f8cff; animation: spin .8s linear infinite; }

@media (max-width: 1100px) {
  body { min-width: 0; }
  .appShell { grid-template-columns: 1fr; }
  .sidebar { position: static; height: auto; }
  nav { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .grid.two { grid-template-columns: 1fr; }
  .topbar { align-items: stretch; flex-direction: column; }
  .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
