{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoDesk",
  "version": "1.0.0",
  "identifier": "dev.repodesk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5177",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RepoDesk",
        "width": 1240,
        "height": 860,
        "minWidth": 960,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://github.com https://objects.githubusercontent.com; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first AI operations cockpit for AI-assisted development.",
    "longDescription": "RepoDesk is a local-first desktop cockpit for AI-assisted development: connect a project, scope a task, build bounded context, run safety/budget checks, route work to the right (preferably local) model, and know when it is safe to commit.",
    "copyright": "Copyright © 2026 RepoDesk",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzN0M1QkM4MzM0Mjc1NzEKUldSeGRVSXp5RnQ4WSswcVU4R1RRcWtJTkRWQzJwOE1Ud1dwSmJFckN2K0JYc0pEV2lYQStOY2YK",
      "endpoints": [
        "https://github.com/MykytaStel/repodesk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
