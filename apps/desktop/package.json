{
  "name": "repodesk-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177",
    "build": "tsc && node --test scripts/performance-budget.test.mjs && vite build && node scripts/check-entry-budget.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4177",
    "tauri": "tauri",
    "desktop:icon": "tauri icon app-icon.svg --output src-tauri/generated/repodesk-icons",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
